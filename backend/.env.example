# --- Gemini keys ---
# Keys are managed from the app (Settings > Gemini API keys): add many, one active at a time.
# GEMINI_API_KEY is optional: if the key store is empty at startup it is added and activated once.
GEMINI_API_KEY=
KEYS_FILE=./data/keys.json
# Encrypts the key file (AES-256-GCM). Generate with: openssl rand -hex 32. Keep it; losing it makes stored keys unreadable.
KEYS_SECRET=
# Separate from device tokens. Only this token can add, switch or delete keys. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Model used when the app doesn't ask for one, and the models the app may request (comma separated)
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_MODELS=gemini-2.5-flash
AUTH_MODE=token
# comma-separated; generate each with: openssl rand -hex 32
DEVICE_TOKENS=
PORT=8080
