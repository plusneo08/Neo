<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black"
        app:tabTextColor="@color/holo_dim"
        app:tabSelectedTextColor="@color/holo_blue"
        app:tabIndicatorColor="@color/holo_blue"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <View
            android:id="@+id/micDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/mic_dot"
            android:alpha="0.3" />

        <TextView
            android:id="@+id/micState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mic_idle"
            android:textColor="@color/holo_blue"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
